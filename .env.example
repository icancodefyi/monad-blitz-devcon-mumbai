# Monad testnet is mandatory until wallet execution and receipts pass end-to-end tests.
DONADS_NETWORK=testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
DONADS_BIND_ADDRESS=127.0.0.1:8080
# Cloud hosts may provide PORT instead. DONADS_BIND_ADDRESS takes precedence when both exist.
DONADS_TASK_STORE=data/tasks.json
DONADS_PROFILE_STORE=data/profiles.json
DONADS_ROUTINE_STORE=data/routines.json
DONADS_AUTH_DOMAIN=localhost:3000
DONADS_AUTH_URI=http://localhost:3000
DONADS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DONADS_SESSION_REQUESTS_PER_MINUTE=120
RUST_LOG=donads_dispatch=info,tower_http=info

# Future real execution. Use a browser wallet or KMS reference; never commit a private key.
DONADS_POLICY_VAULT_ADDRESS=
DONADS_SIGNER_KEY_REFERENCE=

# Valid only for a merchant that directly accepts the configured crypto asset.
DONADS_CRYPTO_MERCHANT_URL=
DONADS_CRYPTO_MERCHANT_TOKEN=
