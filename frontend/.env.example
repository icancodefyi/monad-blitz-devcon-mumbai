# Injected automatically when a Postgres integration is connected in Vercel.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Monad Testnet only until the audited mainnet readiness checklist passes.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Optional override. Leave unset in Vercel so the browser uses same-origin /api.
# NEXT_PUBLIC_DONADS_API_URL=/api

# Public client identifier used by the Reown wallet chooser and QR modal.
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# Optional until the model gateway is activated. Keep both server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


DONADS_CONNECTOR_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
DONADS_PUBLIC_APP_URL=https://your-donads-domain.example

# Evidence-only mainnet readiness inputs. These do not enable mainnet execution.
DONADS_SECURITY_REVIEW_ARTIFACT=
DONADS_SIGNER_KEY_REFERENCE=
DONADS_SIGNER_RUNBOOK_URL=
DONADS_INCIDENT_RUNBOOK_URL=
MONAD_MAINNET_RPC_URLS=
DONADS_TESTNET_WORKFLOW_ARTIFACT=
DONADS_CONTRACT_INVARIANT_ARTIFACT=
DONADS_PENTEST_ARTIFACT=
DONADS_AI_SECURITY_ARTIFACT=
DONADS_SECRET_SCAN_ARTIFACT=
DONADS_TRANSACTION_RECOVERY_ARTIFACT=
DONADS_EMERGENCY_DRILL_ARTIFACT=
DONADS_ALLOWLIST_ARTIFACT=
DONADS_POLICY_TEST_ARTIFACT=
DONADS_MULTISIG_ARTIFACT=
DONADS_RECOVERY_DRILL_ARTIFACT=
DONADS_DATA_POLICY_ARTIFACT=
DONADS_MERCHANT_SUPPORT_ARTIFACT=
DONADS_BETA_ARTIFACT=
DONADS_GO_NO_GO_ARTIFACT=

# Scheduled payments: shared secret for /api/cron/schedules (Vercel Cron or the local bridge). 32+ characters.
CRON_SECRET=
