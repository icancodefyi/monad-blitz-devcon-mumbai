# Required: Postgres (Neon). Injected automatically by the Vercel Neon integration.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Monad Testnet RPC. DONADS runs on testnet only.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Optional override. Leave unset so the browser uses same-origin /api.
# NEXT_PUBLIC_DONADS_API_URL=/api

# WalletConnect / Reown project id used by RainbowKit (free at cloud.reown.com).
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id
# Public app URL shown to wallets during connection (defaults to https://donads.vercel.app).
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extra allowed browser origins for the API, comma-separated (local: http://localhost:3000).
# DONADS_ALLOWED_ORIGINS=http://localhost:3000

# Optional AI planning (Gemini). Without a key DONADS uses its deterministic planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram approvals. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 32+ random characters, for example the output of `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=
# Public https URL of the app, used for Telegram links and the production webhook.
DONADS_PUBLIC_APP_URL=https://your-donads-domain.example
# Local development: use polling with `npm run telegram:poll` instead of a webhook.
# TELEGRAM_DELIVERY=polling

# Scheduled payments and wallet watch: shared secret for /api/cron/* (32+ characters).
CRON_SECRET=

# Evidence-only mainnet readiness inputs. These do not enable mainnet execution.
DONADS_SECURITY_REVIEW_ARTIFACT=
DONADS_SIGNER_KEY_REFERENCE=
DONADS_SIGNER_RUNBOOK_URL=
DONADS_INCIDENT_RUNBOOK_URL=
MONAD_MAINNET_RPC_URLS=
DONADS_TESTNET_WORKFLOW_ARTIFACT=
DONADS_CONTRACT_INVARIANT_ARTIFACT=
DONADS_PENTEST_ARTIFACT=
DONADS_AI_SECURITY_ARTIFACT=
DONADS_SECRET_SCAN_ARTIFACT=
DONADS_TRANSACTION_RECOVERY_ARTIFACT=
DONADS_EMERGENCY_DRILL_ARTIFACT=
DONADS_ALLOWLIST_ARTIFACT=
DONADS_POLICY_TEST_ARTIFACT=
DONADS_MULTISIG_ARTIFACT=
DONADS_RECOVERY_DRILL_ARTIFACT=
DONADS_DATA_POLICY_ARTIFACT=
DONADS_MERCHANT_SUPPORT_ARTIFACT=
DONADS_BETA_ARTIFACT=
DONADS_GO_NO_GO_ARTIFACT=
